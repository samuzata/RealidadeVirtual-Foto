<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset = "UTF-8">
        <meta name = "viewport" 
        content = "width=device-width, inicial-scale=1">
        <title> Ambiente virtual 360 </title>
        <script scr="https://aframe.io/releases/1.6.0/aframe/min.js">
        </script>
        <style>
            body{
                margin: 0;
                font-family: Arial, sans-serif;
            }
            #info{
                position: fixed;
                top: 12px;
                left: 12px;
                z-index: 10;
                padding: 12px 15px;
                background: rgba(0,0,0,0.7);
                color: white;
                border-radius: 8px;
                font-size: 14px;
            }
        </style>
    </head>
    <body>
        <div id="info">
            Ambiente Virtual 360°
            <br> Clique e arraste 
        </div>
        <a/scene 
            vr-mode-ui = "enabled:true"
            renderer="antialias:true">
        
            <a-sky> 
                src = "washington360.jfif"
                rotation = "0 -90 0"
            </a-sky>
        </a>
    </body>
</html>